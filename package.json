{
  "name": "celebration-event-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Gemini-powered planning assistant for weddings, birthdays and community events: budgets, timelines, vendor checklists and personalised ideas.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
